<Window x:Class="Q2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Q2"
        mc:Ignorable="d"
        Title="Course Management" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. FILTER AREA -->
        <GroupBox Grid.Row="0" Header="FILTER AREA" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cbFilterCategory" Width="180" Margin="0,0,20,0"
                          DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"/>

                <TextBlock Text="Instructor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cbFilterInstructor" Width="180" Margin="0,0,20,0"
                          DisplayMemberPath="InstructorName" SelectedValuePath="InstructorId"/>

                <Button x:Name="btnFilter" Content="Filter" Width="80" Margin="0,0,10,0"
                        Click="btnFilter_Click"/>
                <Button x:Name="btnClearFilter" Content="Clear Filter" Width="90"
                        Click="btnClearFilter_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. COURSE LIST -->
        <GroupBox Grid.Row="1" Header="COURSE LIST" Padding="10" Margin="0,0,0,10">
            <DataGrid x:Name="dgCourses"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CourseId" Binding="{Binding CourseId}" Width="70"/>
                    <DataGridTextColumn Header="CourseTitle" Binding="{Binding CourseTitle}" Width="*"/>
                    <DataGridTextColumn Header="CourseCode" Binding="{Binding CourseCode}" Width="100"/>
                    <DataGridTextColumn Header="DurationHours" Binding="{Binding DurationHours}" Width="100"/>
                    <DataGridTextColumn Header="TuitionFee" Binding="{Binding TuitionFee, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="CategoryName" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTextColumn Header="InstructorName" Binding="{Binding InstructorName}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 3. ADD NEW COURSE -->
        <GroupBox Grid.Row="2" Header="ADD NEW COURSE" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="CourseTitle:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="txtCourseTitle" Grid.Row="0" Grid.Column="1" Margin="0,0,15,8" Padding="3"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="CourseCode:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="txtCourseCode" Grid.Row="0" Grid.Column="3" Margin="0,0,15,8" Padding="3"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="DurationHours:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="txtDurationHours" Grid.Row="0" Grid.Column="5" Margin="0,0,0,8" Padding="3"/>

                <!-- Row 1 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="TuitionFee:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="txtTuitionFee" Grid.Row="1" Grid.Column="1" Margin="0,0,15,8" Padding="3"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="cbAddCategory" Grid.Row="1" Grid.Column="3" Margin="0,0,15,8"
                          DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Instructor:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="cbAddInstructor" Grid.Row="1" Grid.Column="5" Margin="0,0,0,8"
                          DisplayMemberPath="InstructorName" SelectedValuePath="InstructorId"/>

                <!-- Row 2: Buttons -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="btnAddCourse" Content="Add Course" Width="100" Margin="0,0,10,0"
                            Click="btnAddCourse_Click"/>
                    <Button x:Name="btnClearForm" Content="Clear Form" Width="100"
                            Click="btnClearForm_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
