<Window x:Class="Q2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRN212_Book" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Search Section -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearchTitle" Width="150" Margin="0,0,10,0"/>

            <TextBlock Text="Publisher:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearchPublisher" Width="150" Margin="0,0,10,0"/>

            <Button x:Name="btnSearch" Content="Search" Width="80" Click="btnSearch_Click"/>
        </StackPanel>

        <!-- Books DataGrid -->
        <DataGrid x:Name="dgBooks"
                  Grid.Row="1" Grid.Column="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgBooks_SelectionChanged"
                  Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="BookID" Binding="{Binding BookId}" Width="Auto"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                <DataGridTextColumn Header="Publication Year" Binding="{Binding PublicationYear}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Section -->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="BookId"/>
            <TextBox x:Name="txtBookId" IsEnabled="False" Margin="0,2,0,8"/>

            <TextBlock Text="Title"/>
            <TextBox x:Name="txtTitle" Margin="0,2,0,8"/>

            <TextBlock Text="Publisher"/>
            <TextBox x:Name="txtPublisher" Margin="0,2,0,8"/>

            <TextBlock Text="Publication Year"/>
            <TextBox x:Name="txtPublicationYear" Margin="0,2,0,12"/>

            <Button x:Name="btnSave" Content="Save Changes" Width="100" HorizontalAlignment="Center" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
